{
  "name": "@zhenhuang/pi-xai-search",
  "version": "0.1.0",
  "description": "Model-independent live X search for Pi, powered by xAI's native x_search tool",
  "keywords": [
    "grok",
    "pi-extension",
    "pi-package",
    "search",
    "twitter",
    "x-search",
    "xai"
  ],
  "homepage": "https://github.com/ZhenHuangLab/pi-xai-search#readme",
  "bugs": {
    "url": "https://github.com/ZhenHuangLab/pi-xai-search/issues"
  },
  "license": "MIT",
  "author": "ZhenHuangLab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhenHuangLab/pi-xai-search.git"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run check"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@types/node": "^24.0.0",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.74.0",
    "typebox": "^1.3.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.83.0",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
