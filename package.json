{
  "name": "pi-extensions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=11.5.1"
  },
  "scripts": {
    "check": "npm run check --workspaces",
    "test": "npm test --workspaces --if-present",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3"
  }
}
