{
  "name": "pi-better-math",
  "version": "0.1.1",
  "description": "Typeset LaTeX math in Pi's TUI as multi-line Unicode art",
  "keywords": [
    "pi-package",
    "pi-extension",
    "latex",
    "math",
    "tex",
    "unicode",
    "tui"
  ],
  "homepage": "https://github.com/ZhenHuangLab/pi-extensions/tree/main/packages/pi-better-math#readme",
  "bugs": {
    "url": "https://github.com/ZhenHuangLab/pi-extensions/issues"
  },
  "license": "GPL-3.0-or-later",
  "author": "ZhenHuangLab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhenHuangLab/pi-extensions.git",
    "directory": "packages/pi-better-math"
  },
  "files": [
    "index.ts",
    "transform.ts",
    "render-worker.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node --check index.ts && node --check transform.ts && node --check render-worker.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "dependencies": {
    "libtexprintf": "^1.31.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
