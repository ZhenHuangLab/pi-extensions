{
  "name": "pi-pleat",
  "version": "0.2.0",
  "description": "Background context compaction and original message recall for Pi, with native Anthropic and OpenAI Responses compaction",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "files": [
    "src",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhenHuangLab/pi-extensions.git",
    "directory": "packages/pi-pleat"
  },
  "homepage": "https://github.com/ZhenHuangLab/pi-extensions/tree/main/packages/pi-pleat#readme",
  "bugs": {
    "url": "https://github.com/ZhenHuangLab/pi-extensions/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json && for file in test/*.mjs; do node --check \"$file\" || exit; done",
    "test": "node --test test/*.test.mjs",
    "test:live": "PI_CONTEXT_LIVE=1 node --test test/live.test.mjs test/native.test.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@types/node": "22.20.5",
    "typebox": "1.3.27",
    "typescript": "6.0.3"
  }
}
